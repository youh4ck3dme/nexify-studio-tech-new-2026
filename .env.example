RESEND_API_KEY=re_your_api_key_here
CONTACT_FROM_EMAIL=noreply@yourdomain.com
CONTACT_TO_EMAIL=your-email@example.com
CONTACT_COPY_EMAIL=copy-email@example.com

# Credentials Auth
# Generate JWT_SECRET with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# Generate ADMIN_PASSWORD_HASH with: pnpm auth:hash "<your-password>"
# Never store the plaintext password - only the bcrypt hash.
# IMPORTANT: in .env.local specifically, every "$" in the hash must be
# escaped as "\$" (e.g. "\$2b\$12\$...") - @next/env otherwise expands
# unescaped "$..." sequences as shell-style variable references and
# silently empties the hash. The auth:hash script prints both forms.
ADMIN_EMAIL=admin@kestudio.sk
ADMIN_PASSWORD_HASH=replace_with_bcrypt_hash

NEXT_PUBLIC_BASE_URL=https://kestudio.sk
